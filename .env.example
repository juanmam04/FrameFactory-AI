# 1) Guiones (obligatorio)
OPENAI_API_KEY=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

# 2) Voz (elegí una opción)
# Opción A: ElevenLabs (si tenés API key y VOICE_ID, siempre se usa esta voz, también en guiones largos)
ELEVENLABS_API_KEY=sk_75d8d673c21c8889a5f77d5718f38e4924d23fb4625ed70d
ELEVENLABS_VOICE_ID=l1zE9xgNpUTaQCZzpNJa
# Opcional: si ElevenLabs falla, no usar OpenAI como respaldo (ELEVENLABS_SOLO=true)

# Opción B: usar OpenAI TTS (dejá ElevenLabs vacío y usá tu OPENAI_API_KEY)
# OPENAI_TTS_MODEL=tts-1-hd
# OPENAI_TTS_VOICE=alloy

# 3) Imágenes – elegí UN backend (IMAGE_BACKEND)
# Opción A: openai (recomendado; DALL-E 3 en la nube de OpenAI, NO usa RunPod)
IMAGE_BACKEND=openai
# Generación en paralelo (2–5): más escenas a la vez = más rápido. No exceder 5 por rate limits.
# DALL_E_PARALLEL=3

# Opción B: comfyui (RunPod) – para que el RunPod no sea al pedo, usá SDXL.
# IMAGE_BACKEND=comfyui
# COMFYUI_URL=https://TU_POD_ID-8188.proxy.runpod.net
# En RunPod: descargá SDXL en ComfyUI/models/checkpoints/ (ej. sdXL_v10.safetensors).
# Si hay varios checkpoints, se prioriza SDXL solo. Si solo tenés uno, poné:
# COMFYUI_CHECKPOINT=sdXL_v10.safetensors
# COMFYUI_SDXL=true
# COMFYUI_PARALLEL=3
# COMFYUI_VERIFY_SSL=false
# COMFYUI_TIMEOUT_CONNECT=15
# COMFYUI_TIMEOUT_POST=90
# COMFYUI_TIMEOUT_POLL=300
# Ruta a la carpeta de ComfyUI (para scripts/start_comfyui.ps1); opcional.
# COMFYUI_PATH=C:\ComfyUI
# Usar OpenAI DALL-E para generar las imágenes (para probar sin ComfyUI). Requiere OPENAI_API_KEY.
# USE_OPENAI_IMAGES=true

# -----------------------------------------------------------------------------
# Opcionales (podés dejarlos vacíos)
# -----------------------------------------------------------------------------
# Modelo de OpenAI para guiones (por defecto gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Música de fondo fija (ruta a un .mp3 o .wav)
# BACKGROUND_MUSIC_PATH=
