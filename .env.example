# Opción B: usar OpenAI TTS (dejá lo anterior vacío y usá tu OPENAI_API_KEY)
# OPENAI_TTS_MODEL=tts-1-hd
# OPENAI_TTS_VOICE=alloy

# 3) Imágenes – ComfyUI (obligatorio para generar imágenes)
# Local:
COMFYUI_URL=http://127.0.0.1:8188
# RunPod: exponé el puerto 8188 en el Pod y usá la URL proxy o la IP:puerto. Ejemplo:
# COMFYUI_URL=https://TU_POD_ID-8188.proxy.runpod.net
# COMFYUI_URL=http://103.196.86.192:8188
# Nombre del checkpoint en ComfyUI/models/checkpoints (vacío = auto-detecta el primero).
# COMFYUI_CHECKPOINT=v1-5-pruned-emaonly.safetensors
# Opcionales para ComfyUI remoto (más tiempo de espera; SSL por defecto true):
# COMFYUI_TIMEOUT_CONNECT=15
# COMFYUI_TIMEOUT_POST=90
# COMFYUI_TIMEOUT_POLL=300
# COMFYUI_VERIFY_SSL=false
# Ruta a la carpeta de ComfyUI (para scripts/start_comfyui.ps1); opcional.
# COMFYUI_PATH=C:\ComfyUI
# Usar OpenAI DALL-E para generar las imágenes (para probar sin ComfyUI). Requiere OPENAI_API_KEY.
# USE_OPENAI_IMAGES=true

# -----------------------------------------------------------------------------
# Opcionales (podés dejarlos vacíos)
# -----------------------------------------------------------------------------
# Modelo de OpenAI para guiones (por defecto gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Música de fondo fija (ruta a un .mp3 o .wav)
# BACKGROUND_MUSIC_PATH=
