# 2) Voz (elegí una opción)
# Opción A: ElevenLabs (si tenés API key y VOICE_ID, siempre se usa esta voz, también en guiones largos)
ELEVENLABS_API_KEY=sk_75d8d673c21c8889a5f77d5718f38e4924d23fb4625ed70d
ELEVENLABS_VOICE_ID=l1zE9xgNpUTaQCZzpNJa
# Opcional: si ElevenLabs falla, no usar OpenAI como respaldo (ELEVENLABS_SOLO=true)

# Opción B: usar OpenAI TTS (dejá ElevenLabs vacío y usá tu OPENAI_API_KEY)
# OPENAI_TTS_MODEL=tts-1-hd
# OPENAI_TTS_VOICE=alloy

# 3) Imágenes – en la app elegís ComfyUI o Replicate
# Opción A: Replicate (FLUX) – sin instalar ComfyUI. Poné en .env:
# REPLICATE_API_TOKEN=r8_xxxx
# Y en la app elegí "Replicate (FLUX)" como generador.
# Modelo texto→imagen (default flux-dev, más calidad que schnell):
# REPLICATE_IMAGE_MODEL=black-forest-labs/flux-dev
# REPLICATE_IMAGE_MODEL_WITH_REF=black-forest-labs/flux-kontext-dev
# REPLICATE_FLUX_DEV_STEPS=28
# REPLICATE_FLUX_DEV_GUIDANCE=3.5
# Si la bible lista character_reference pero no hay PNG: 0=FLUX solo texto (default), 1=aviso y fallback texto:
# REPLICATE_FORCE_KONTEXT=0
# Enriquecer locaciones ficticias vía LLM (0=solo heurística):
# LOCATION_VISUAL_ENRICH_LLM=1
# Referencia Kontext: identity_sheet (default, anti–model-sheet en el prompt) | scene_reference
# CHARACTER_REFERENCE_MODE=identity_sheet

# Personaje fijo para el Estudio SaaS (overlay MVP): ruta a un PNG (absoluta o relativa al proyecto).
# Si está definido y el archivo existe, tiene prioridad sobre el catálogo y sobre character_reference de visual_bible.
# SAAS_CHARACTER_PNG=assets/mi_personaje.png
# MVP_CHARACTER_PNG (alias de SAAS_CHARACTER_PNG)

# Video de gameplay (fondo en modo MVP «solo gameplay»): ruta absoluta a un .mp4 tuyo (no incluimos clips por licencias).
# GAMEPLAY_BACKGROUND_VIDEO=/Users/vos/Videos/minecraft-parkour.mp4
# GAMEPLAY_VIDEO_ASPECT=16:9

# Opción B: ComfyUI (local o RunPod)
# IMAGE_BACKEND=comfyui
# COMFYUI_URL=http://127.0.0.1:8188
# O en RunPod: COMFYUI_URL=https://TU_POD_ID-8188.proxy.runpod.net
# COMFYUI_VERIFY_SSL=false
# COMFYUI_PATH=/ruta/a/ComfyUI

# 4) Animación de personaje (API externa opcional)
# Activa proveedor externo para mover personaje/lipsync.
# Si falla, el sistema vuelve automáticamente a FFmpeg estático.
# CHARACTER_ANIMATOR_PROVIDER=external
# Endpoint POST que recibe multipart con:
# - image: archivo imagen del personaje
# - audio: archivo de narración
# - text: texto del bloque (nombre configurable abajo)
# Debe devolver mp4 binario o JSON con video_url/video_base64.
# CHARACTER_ANIMATOR_URL=https://tu-api.com/v1/animate
# CHARACTER_ANIMATOR_API_KEY=tu_api_key
# CHARACTER_ANIMATOR_TIMEOUT_SECONDS=180
# CHARACTER_ANIMATOR_VERIFY_SSL=true
# CHARACTER_ANIMATOR_TEXT_FIELD=text
# CHARACTER_ANIMATOR_RESPONSE_VIDEO_URL_FIELD=video_url
# CHARACTER_ANIMATOR_RESPONSE_VIDEO_B64_FIELD=video_base64

# Opción recomendada: HeyGen (avatar hablando)
# CHARACTER_ANIMATOR_PROVIDER=heygen
# HEYGEN_API_KEY=tu_api_key
# HEYGEN_AVATAR_ID=Kristin_public_3_20240108
# HEYGEN_VOICE_ID=2f72ee82b83d4b00af16c4771d611752
# HEYGEN_AVATAR_STYLE=normal
# HEYGEN_BASE_URL=https://api.heygen.com
# HEYGEN_STATUS_URL=https://api.heygen.com/v1/video_status.get
# HEYGEN_DIMENSION_WIDTH=1280
# HEYGEN_DIMENSION_HEIGHT=720
# HEYGEN_HTTP_TIMEOUT_SECONDS=60
# HEYGEN_POLL_INTERVAL_SECONDS=4
# HEYGEN_MAX_WAIT_SECONDS=600
# HEYGEN_TEST_MODE=false
# HEYGEN_USE_INPUT_AUDIO=true
# HEYGEN_AUDIO_VOICE_TYPE=audio
# HEYGEN_ASSET_UPLOAD_URL=https://upload.heygen.com/v1/asset
# Subdominio upload: la doc usa header X-API-KEY; si falla el upload probá:
# HEYGEN_UPLOAD_API_KEY_HEADER=X-API-KEY
# Extras del mismo POST /v2/video/generate (doc "Generate Studio Video"):
# HEYGEN_CAPTION=false
# HEYGEN_CALLBACK_ID=mi_id_para_webhook
# HEYGEN_ASPECT_RATIO=16:9
# HEYGEN_VIDEO_SETTING_JSON={"ejemplo":"ver doc HeyGen"}

# -----------------------------------------------------------------------------
# Opcionales (podés dejarlos vacíos)
# -----------------------------------------------------------------------------
# Modelo de OpenAI para guiones (por defecto gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Música de fondo fija (ruta a un .mp3 o .wav)
# BACKGROUND_MUSIC_PATH=

# Generación de imágenes (Replicate): reintentos ante 429 / rate limit
# REPLICATE_MAX_RETRIES=6
# REPLICATE_RETRY_BASE_SEC=15
# Segundos mínimos entre cada predicción (tier bajo ≈6/min; default 11 si no ponés nada)
# REPLICATE_MIN_INTERVAL_SEC=11
# Alias: si solo querés una variable, esta también controla el mismo espaciado
# REPLICATE_INTER_FRAME_DELAY_SEC=11
# Intentos por frame antes de regeneración semántica (default 4)
# ATTEMPTS_PER_FRAME=4
# Cortar generación si hay N fallos consecutivos de event_match (default 3)
# HARD_FAIL_EVENT_STREAK=3

# -----------------------------------------------------------------------------
# Plataforma web SaaS (FastAPI) — ver README o ejecutar: uvicorn web.main:app --reload
# -----------------------------------------------------------------------------
# Secreto de cookies de sesión (obligatorio en producción)
# WEB_SESSION_SECRET=cambiar-por-hex-largo-aleatorio
# SQLite de la plataforma (usuarios, planes, tokens, proyectos)
# SAAS_DATABASE_PATH=data/framefactory.db
# Primer usuario admin si la BD está vacía (solo bootstrap inicial)
# ADMIN_BOOTSTRAP_EMAIL=admin@tu-dominio.com
# ADMIN_BOOTSTRAP_PASSWORD=definir-password-seguro
# Tokens consumidos por cada video MVP encolado desde la web (default 500)
# SAAS_TOKEN_COST_PER_VIDEO=500
