# =============================================================================
# FRAMEFACTORY-AI – Solo tenés que completar estas credenciales
# Copiá este archivo a .env y rellená los valores (sin comillas).
# =============================================================================

# 1) Guiones (obligatorio)
OPENAI_API_KEY=

# 2) Voz (elegí una opción)
# Opción A: ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Opción B: usar OpenAI TTS (dejá lo anterior vacío y usá tu OPENAI_API_KEY)
# OPENAI_TTS_MODEL=tts-1-hd
# OPENAI_TTS_VOICE=alloy

# 3) Imágenes – Stable Diffusion (obligatorio)
# URL del API (local o nube: RunPod, Vast.ai, etc.)
SD_API_URL=http://127.0.0.1:7860

# -----------------------------------------------------------------------------
# Opcionales (podés dejarlos vacíos)
# -----------------------------------------------------------------------------
# Modelo de OpenAI para guiones (por defecto gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Música de fondo fija (ruta a un .mp3 o .wav)
# BACKGROUND_MUSIC_PATH=
