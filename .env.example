# =============================================================================
# FRAMEFACTORY-AI – Copy to .env and fill in YOUR secrets (never commit .env).
# Do not put real API keys in this example file.
# =============================================================================

# 1) Scripts / LLM (required for documentary + classic pipelines)
OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_MODEL=gpt-4o-mini

# 2) Voice (pick one)
# Option A: ElevenLabs
ELEVENLABS_API_KEY=sk_your-elevenlabs-key-here
ELEVENLABS_VOICE_ID=your-voice-id-here
# ELEVENLABS_SOLO=true

# Option B: OpenAI TTS (leave ElevenLabs empty)
# OPENAI_TTS_MODEL=tts-1-hd
# OPENAI_TTS_VOICE=alloy

# 3) Images (legacy SaaS / classic pipelines — NOT used by Documentary 100-days Flow path)
# REPLICATE_API_TOKEN=r8_xxxx
# REPLICATE_IMAGE_MODEL=black-forest-labs/flux-dev
# REPLICATE_IMAGE_MODEL_WITH_REF=black-forest-labs/flux-kontext-dev
# IMAGE_BACKEND=comfyui
# COMFYUI_URL=http://127.0.0.1:8188
# COMFYUI_VERIFY_SSL=false

# Documentary / SaaS helpers
# SAAS_SKIP_SUPPORT_IMAGES=1
# SAAS_CHARACTER_PNG=assets/mi_personaje.png
# GAMEPLAY_BACKGROUND_VIDEO=/absolute/path/to/gameplay.mp4
# BACKGROUND_MUSIC_PATH=/absolute/path/to/music.mp3

# Optional character video providers (legacy MVP)
# CHARACTER_ANIMATOR_PROVIDER=external
# CHARACTER_ANIMATOR_URL=https://example.com/v1/animate
# HEYGEN_API_KEY=

# Web platform (optional)
# WEB_SESSION_SECRET=replace-with-long-random-string
# SAAS_DATABASE_PATH=data/framefactory.db
# SAAS_TOKEN_COST_PER_VIDEO=500

# SECURITY NOTE (FF100-P0-008):
# If this file ever contained real-looking keys, rotate those credentials immediately.
